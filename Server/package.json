    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*": "npm run format",
    "**/*.{js,ts}": "npm run lint:fix"
  },
  "author": "dient16",
  "license": "ISC",
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
