# --- Server ---
NODE_ENV=development
HOST=localhost
PORT=9009
SERVER_URL=http://localhost:9009
CLIENT_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:8000

# --- Rate limiting ---
COMMON_RATE_LIMIT_MAX_REQUESTS=1000
COMMON_RATE_LIMIT_WINDOW_MS=1000

# --- Database ---
MONGODB_URL=

# --- Search ---
# atlas = Atlas Search (chay ngay trong cluster MongoDB, khong can dong bo) - tao index
# "apartments_search" tren collection apartments theo src/services/search/atlasIndex.json.
# elasticsearch = dung ES ben ngoai. Backend nao hong thi search tu roi ve Mongo regex.
SEARCH_PROVIDER=atlas

# --- Elasticsearch (chi can khi SEARCH_PROVIDER=elasticsearch) ---
# Elastic Cloud: copy endpoint cua Elasticsearch (khong phai Kibana), vd
# https://<deployment>.es.<region>.<csp>.elastic-cloud.com:443
# Local docker (npm run es:up): http://localhost:9200 va de trong API key.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# --- JWT ---
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Mail (Gmail SMTP app password) ---
EMAIL_NAME=
EMAIL_APP_PASSWORD=

# --- Payment ---
STRIPE_SECRET_KEY=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Geocoder ---
# Only needed when your DNS blocks nominatim.openstreetmap.org (it then resolves to
# 127.0.0.1 and address suggestions fail with ECONNREFUSED). Example: 1.1.1.1,8.8.8.8
GEOCODER_DNS=

# --- Proxy ---
# Reverse-proxy hops to trust for the client IP. 0 = none (local dev), 1 = behind one
# nginx/CDN. Setting this too high lets callers spoof their IP past the rate limiter.
TRUST_PROXY=0

# Chat module (/api/chat) - own database + encryption key (AES-256-GCM key material; keep stable)
CHAT_MONGODB_URL=mongodb+srv://chat-app:mIS54S58UwgIOIaj@chat-app.kryzgoc.mongodb.net/
CHAT_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Tenor sticker/GIF search for the chat (free key: https://developers.google.com/tenor). Empty = hidden
TENOR_API_KEY=
